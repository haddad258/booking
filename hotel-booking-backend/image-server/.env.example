# Port this image server listens on.
IMAGE_SERVER_PORT=5001

# Same physical folder the main API writes uploads into. Leave unset to use
# the default (../storage/public/uploads relative to this folder), which is
# correct as long as image-server/ stays a sibling of backend/storage/.
STORAGE_DIR=

# Comma-separated CORS origins — kept for parity with the main API's config
# style, though images are served publicly to any origin regardless (see
# server.js comments).
CORS_ORIGINS=
